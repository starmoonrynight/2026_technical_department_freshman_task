# 复制成 .env 再改。.env 已在 .gitignore 里，不会被提交。
#   cp .env.example .env
#
# 启动时 config.Load() 会一次性把这些解析进 config.Config。
# 缺必填项会立刻 fatal 并打印缺哪个变量 —— 不会带着半残的配置继续跑。

# ---------- 服务 ----------
ENV=dev
PORT=8080
LOG_LEVEL=info

# ---------- 数据库（对应 docker-compose.yml）----------
# 拆成 5 个变量而不是一整条 DSN 字符串，是因为不用记连接串语法
DB_HOST=localhost
DB_PORT=5432
DB_USER=lf
DB_PASSWORD=lf
DB_NAME=lostfound

# ---------- JWT ----------
# ⚠ 必填且没有默认值。给个默认值等于给所有部署实例同一把钥匙。
# 生成一个随机串（Git Bash 里）：
#   openssl rand -hex 32
JWT_SECRET=

JWT_EXPIRE_HOURS=24

# ---------- 图片上传 ----------
UPLOAD_DIR=./uploads
UPLOAD_BASE_URL=/uploads

# ---------- 匹配算法调参（§5）----------
# 做成环境变量的意义：调参不用改代码、不用重新编译
MATCH_TIME_TOLERANCE_HOURS=24
MATCH_DECAY_DAYS=14
MATCH_NOTIFY_THRESHOLD=0.75
MATCH_SHOW_THRESHOLD=0.55

# ---------- 杭电助手 SSO（M8 才用，现在全部留空即可）----------
# ⚠ APP_SECRET 绝不能进前端代码，只能出现在后端环境变量里
# ⚠ SSO_STATE_KEY 是加密 OAuth state 的密钥，同样必填且无默认值（M8 开工时再设）
SSO_STATE_KEY=
HDUHELP_APP_ID=
HDUHELP_APP_SECRET=
HDUHELP_REDIRECT_URI=
HDUHELP_SCOPE=USER_BASIC

# ---------- 集成测试（只写在命令行，不要放进 .env）----------
# TEST_DB_DSN="postgres://lf:lf@localhost:5432/postgres?sslmode=disable"
# REQUIRE_INTEGRATION=1
# 两个变量的作用见 §10：前者为空则跳过集成测试，后者为 1 时「为空」直接算失败，
# 防止「全绿但其实一条集成测试都没跑」。
